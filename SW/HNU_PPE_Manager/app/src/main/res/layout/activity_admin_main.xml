<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/layoutAdminMainRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ss_bg"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/layoutAdminHeader"
        android:layout_width="match_parent"
        android:layout_height="96dp"
        android:background="@color/ss_header"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="24dp"
        android:paddingEnd="24dp">

        <TextView
            android:id="@+id/txtAdminTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="기기 관리"
            android:textColor="#FFFFFF"
            android:textSize="36sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnRefresh"
            android:layout_width="126dp"
            android:layout_height="60dp"
            android:background="@drawable/bg_header_button"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="새로고침"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/layoutAdminContent"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="22dp"
        android:paddingTop="20dp"
        android:paddingEnd="22dp">

        <TextView
            android:id="@+id/btnMonitoring"
            android:layout_width="match_parent"
            android:layout_height="84dp"
            android:background="@drawable/bg_green_button"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="모니터링 시작"
            android:textColor="#FFFFFF"
            android:textSize="31sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtDangerTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="현재 위험 작업자"
            android:textColor="@color/ss_dark"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtDangerEmpty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_card"
            android:gravity="center_vertical"
            android:minHeight="66dp"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:text="현재 위험 상태의 작업자가 없습니다."
            android:textColor="@color/ss_sub"
            android:textSize="23sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerDangerWorkers"
            android:layout_width="match_parent"
            android:layout_height="238dp"
            android:layout_marginTop="10dp"
            android:clipToPadding="false"
            android:visibility="gone" />

        <TextView
            android:id="@+id/txtLocationTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="구역별 보기"
            android:textColor="@color/ss_dark"
            android:textSize="30sp"
            android:textStyle="bold" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="68dp"
            android:layout_marginTop="10dp"
            android:fillViewport="false"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/layoutLocationFilters"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <TextView
            android:id="@+id/txtWorkerEmpty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_card"
            android:gravity="center_vertical"
            android:minHeight="66dp"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:text="표시할 작업자 데이터가 없습니다."
            android:textColor="@color/ss_sub"
            android:textSize="23sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerWorkerDevices"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="10dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingBottom="24dp" />

    </LinearLayout>

</LinearLayout>
