<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/layoutWorkerDeviceItem"
    android:layout_width="match_parent"
    android:layout_height="178dp"
    android:layout_marginBottom="14dp"
    android:background="@drawable/bg_card"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingEnd="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/txtDeviceIdLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="DEVICE_ID : "
            android:textColor="@color/ss_dark"
            android:textSize="27sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtDeviceIdValue"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="-"
            android:textColor="@color/ss_dark"
            android:textSize="27sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/txtWorkLocationLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="작업 위치 : "
            android:textColor="@color/ss_sub"
            android:textSize="25sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtWorkLocationValue"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="-"
            android:textColor="@color/ss_sub"
            android:textSize="25sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/txtRiskLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="현재 위험도 : "
            android:textColor="@color/ss_sub"
            android:textSize="25sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtRiskValue"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="-"
            android:textColor="@color/ss_red"
            android:textSize="25sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
